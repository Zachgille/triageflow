{
  "name": "triageflow",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "corepack pnpm -r build",
    "db:generate": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:generate",
    "db:migrate": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:migrate:dev",
    "db:migrate:deploy": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:migrate:deploy",
    "db:reset": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:migrate:reset",
    "db:seed": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:seed",
    "db:seed:large": "dotenv -e .env -- node scripts/seed-large.mjs",
    "db:seed:large:dry-run": "dotenv -e .env -- node scripts/seed-large.mjs --dry-run",
    "db:validate": "dotenv -e .env -- corepack pnpm --filter @triageflow/db prisma:validate",
    "dev": "corepack pnpm --parallel --filter @triageflow/web --filter @triageflow/api --filter @triageflow/worker dev",
    "env:doctor": "node scripts/env-doctor.mjs",
    "format": "prettier --write .",
    "infra:down": "docker-compose -f infra/docker-compose.yml down",
    "infra:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "infra:up": "docker-compose -f infra/docker-compose.yml up -d",
    "lint": "eslint .",
    "bench:k6:comments": "node scripts/run-k6.mjs comments",
    "bench:k6:mixed": "node scripts/run-k6.mjs mixed",
    "bench:k6:tickets": "node scripts/run-k6.mjs tickets",
    "db:bench:counts": "dotenv -e .env -- node scripts/bench-counts.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "test": "corepack pnpm -r test",
    "test:integration": "corepack pnpm --filter @triageflow/api test:integration",
    "typecheck": "corepack pnpm --filter @triageflow/config build && corepack pnpm --filter @triageflow/db build && corepack pnpm --filter @triageflow/shared build && corepack pnpm -r typecheck",
    "worker:analytics:rollup": "dotenv -e .env -- corepack pnpm --filter @triageflow/worker analytics:rollup",
    "worker:analytics:schedule-once": "dotenv -e .env -- corepack pnpm --filter @triageflow/worker analytics:schedule-once",
    "worker:sla:check": "dotenv -e .env -- corepack pnpm --filter @triageflow/worker sla:check",
    "worker:queues:status": "dotenv -e .env -- corepack pnpm --filter @triageflow/worker queues:status"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
